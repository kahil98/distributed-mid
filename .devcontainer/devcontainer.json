{
  "name": "Distributed MID demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "installDockerComposeSwitch": true
    }
  },
  "forwardPorts": [3000, 5173, 8080, 8100, 9090, 15672],
  "portsAttributes": {
    "3000": { "label": "Grafana", "onAutoForward": "notify" },
    "5173": { "label": "Distributed MID UI", "onAutoForward": "openBrowser" },
    "8080": { "label": "Gateway API and Swagger", "onAutoForward": "notify" },
    "8100": { "label": "Metadata API", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "notify" },
    "15672": { "label": "RabbitMQ management", "onAutoForward": "notify" }
  },
  "postCreateCommand": "python -m pip install --disable-pip-version-check -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
