{
  "info": {
    "name": "Distributed Storage Gateway - Task 4",
    "description": "JWT-authenticated gateway checks. Set baseUrl, username and password in collection variables; run requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://127.0.0.1:8080"},
    {"key":"username","value":"exam-user"},
    {"key":"password","value":"change-me"},
    {"key":"token","value":""},
    {"key":"bucket","value":"exam-gateway-demo"},
    {"key":"objectKey","value":"evidence/hello.txt"}
  ],
  "item": [
    {"name":"01 - Issue JWT", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/auth/token"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login returns 200', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('Bearer token returned', () => pm.expect(body.token_type).to.eql('bearer'));","pm.collectionVariables.set('token', body.access_token);"]}}]},
    {"name":"02 - Gateway interface (JWT)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/v1"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Authenticated API index returns 200', () => pm.response.to.have.status(200));","pm.test('Interface lists endpoints', () => pm.expect(pm.response.json().endpoints.length).to.be.above(0));"]}}]},
    {"name":"03 - Create bucket","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"bucket\":\"{{bucket}}\"}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/v1/buckets"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Bucket created (or already exists)', () => pm.expect([201,409]).to.include(pm.response.code));"]}}]},
    {"name":"04 - List buckets","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/v1/buckets"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Bucket list returns 200', () => pm.response.to.have.status(200));","pm.test('Demo bucket visible', () => pm.expect(pm.response.json().some(x => x.bucket === pm.collectionVariables.get('bucket'))).to.eql(true));"]}}]},
    {"name":"05 - Upload object with tags","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"text/plain"},{"key":"X-Object-Tags","value":"{\"course\":\"exam\",\"kind\":\"note\"}"}],"body":{"mode":"raw","raw":"Gateway streaming upload test payload."},"url":"{{baseUrl}}/v1/buckets/{{bucket}}/objects/{{objectKey}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Upload returns 200', () => pm.response.to.have.status(200));","pm.test('Metadata includes object key', () => pm.expect(pm.response.json().key).to.eql(pm.collectionVariables.get('objectKey')));"]}}]},
    {"name":"06 - Search by prefix and tag","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/v1/buckets/{{bucket}}/objects?prefix=evidence/&tags=%7B%22course%22%3A%22exam%22%7D","host":["{{baseUrl}}"],"path":["v1","buckets","{{bucket}}","objects"],"query":[{"key":"prefix","value":"evidence/"},{"key":"tags","value":"{\"course\":\"exam\"}"}]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Search returns 200 and tagged match', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().count).to.be.above(0); });"]}}]},
    {"name":"07 - Get object metadata","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/v1/buckets/{{bucket}}/objects/{{objectKey}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Metadata returns stored tags', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().tags.course).to.eql('exam'); });"]}}]},
    {"name":"08 - Download first 7 bytes (Range)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Range","value":"bytes=0-6"}],"url":"{{baseUrl}}/v1/download/{{bucket}}/{{objectKey}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Range request returns 206', () => pm.response.to.have.status(206));","pm.test('Content-Range is present', () => pm.expect(pm.response.headers.get('Content-Range')).to.match(/^bytes 0-6\\//));"]}}]},
    {"name":"09 - Cluster status","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/v1/cluster/status"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Cluster status includes node and degradation fields', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b).to.have.property('nodes'); pm.expect(b).to.have.property('degraded_objects'); });"]}}]},
    {"name":"10 - Delete object","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/v1/buckets/{{bucket}}/objects/{{objectKey}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Delete returns 204', () => pm.response.to.have.status(204));"]}}]}
  ]
}
